# Токены можно НЕ класть сюда, а задать переменными окружения пользователя (Windows: «Переменные среды»):
#   T_INVEST_IIS_READ  — токен только-чтение боевого счёта
#   T_INVEST_SANDBOX   — токен песочницы
# Этот файл нужен только если переменных нет. Его читают только скрипты скилла; в чат токены не попадают.

# Токен T-Invest API с правами «только чтение» на нужные счета (tbank.ru/invest/settings/api)
TINVEST_TOKEN=t.xxxxxxxx

# Отдельный токен песочницы (выпускается там же, для sandbox) — для экспериментов и ступени 3
TINVEST_SANDBOX_TOKEN=

# CA-бандл с сертификатами Минцифры (создаёт scripts/make_ca_bundle.py). Пусто — системные корни.
TINVEST_CA_BUNDLE=

# Какие счета выгружать (id через запятую). Пусто — все открытые, доступные токену.
TINVEST_ACCOUNT_ID=

# Бенчмарки для сравнения «те же взносы в …» (тикеры фондов на Мосбирже)
BENCH_TICKERS=LQDT,SBMX

# Целевые доли для deploy (по умолчанию ~/.tinvest/targets.yaml)
# TINVEST_TARGETS=

# Адреса API менять не нужно. Если tbank.ru не открывается — альтернативные домены:
# TINVEST_BASE_URL=https://invest-public-api.tinkoff.ru/rest
# TINVEST_SANDBOX_BASE_URL=https://sandbox-invest-public-api.tinkoff.ru/rest
