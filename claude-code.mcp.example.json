      "headers": { "Authorization": "Bearer ${T_INVEST_IIS_READ}" }
    },
    "t-invest-sandbox": {
      "type": "http",
      "url": "https://sandbox-invest-public-api.tbank.ru/mcp",
      "headers": { "Authorization": "Bearer ${T_INVEST_SANDBOX}" }
    }
  }
}
